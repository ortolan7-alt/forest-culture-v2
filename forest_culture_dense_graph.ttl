    crm:P2_has_type <http://data.urbanforest.kr/vocab/Type/%EB%AA%A9%EC%9E%AC%EC%83%9D%EC%82%B0%EC%88%B2>,
        <http://data.urbanforest.kr/vocab/Type/%EC%88%B2>,
