        <http://data.urbanforest.kr/vocab/Type/%EB%B3%B4%ED%98%B8%EC%88%98>,
        <http://data.urbanforest.kr/vocab/Type/%EC%82%AC%EC%A0%81%20%EB%B0%8F%20%EA%B7%BC%EB%8C%80%EC%9C%A0%EC%82%B0>,
